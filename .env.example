# Never commit a real .env file. Export variables into your shell before running.
MINIROUTER_ADDR=127.0.0.1:8080
MINIROUTER_API_KEY=change-this-dev-token

# Optional: router/auto gives up on a model whose stream has not started after
# this long and tries the next one; the last candidate always waits. Off when unset.
# MINIROUTER_FIRST_EVENT_TIMEOUT=20s

# Optional real-provider credentials (not needed for demo/echo)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Choose real model IDs that are available in your provider accounts.
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# GEMINI_MODEL=gemini-2.5-flash

# Optional USD per ONE MILLION tokens. All rates must reflect your CURRENT
# provider invoice tier; NO real prices are preconfigured or assumed.
# OPENAI_INPUT_USD_PER_1M=...
# OPENAI_OUTPUT_USD_PER_1M=...
# OPENAI_CACHE_READ_USD_PER_1M=...
# ANTHROPIC_INPUT_USD_PER_1M=...
# ANTHROPIC_OUTPUT_USD_PER_1M=...
# ANTHROPIC_CACHE_READ_USD_PER_1M=...
# ANTHROPIC_CACHE_WRITE_USD_PER_1M=...
# GEMINI_INPUT_USD_PER_1M=...
# GEMINI_OUTPUT_USD_PER_1M=...
# GEMINI_CACHE_READ_USD_PER_1M=...
